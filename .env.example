# ── Mini-VSS environment variables ───────────────────────────
# Copy to .env and adjust. Every value has a sensible default; the
# stack runs fully offline (CPU + Ollama) with no keys at all.

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── LLM backend ───────────────────────────────────────────────
# If set, Q&A + summaries use Anthropic (claude-haiku-4-5-20251001).
# If empty, Mini-VSS falls back to a local Ollama endpoint (offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama fallback for Q&A + summaries
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Separate Ollama server for caption generation (leave empty to use OLLAMA_BASE_URL)
OLLAMA_CAPTION_BASE_URL=

# ── Ingestion limits ──────────────────────────────────────────
MAX_VIDEO_SECONDS=900
MAX_VIDEO_MB=600

# ── Scene-change detection (see frame_extractor.py docstring) ─
DIFF_THRESHOLD=0.05          # mean abs pixel diff in [0,1]
HIST_THRESHOLD=0.15          # chi-squared histogram distance
MIN_SCENE_GAP_SEC=0.5        # cool-down between keyframes
MAX_GAP_SEC=0.5              # force a keyframe every N seconds even with no scene cut
ANALYSIS_FPS=20.0             # decode rate for cut detection
MAX_KEYFRAMES=120             # keep memory pressure manageable on 4 GB VRAM

# ── Object detection ──────────────────────────────────────────
DETECTOR_MODEL=/app/model-cache/yolov8n.pt
DETECTOR_CONFIDENCE=0.35
DETECTOR_BATCH_SIZE=8         # safe batch for 4 GB VRAM (YOLO shares GPU with Qwen+CLIP)
# Comma-separated COCO class names to keep; empty = all 80 classes.
DETECTOR_CLASSES=

# ── Captioning ────────────────────────────────────────────────
# CAPTION_BACKEND: qwen (local Qwen2.5-VL on CPU/GPU), blip, or auto.
CAPTION_BACKEND=qwen
# CAPTION_FORMAT: flat (KEY: value lines — robust for small models) or json
# (strict JSON — needs a capable model).
CAPTION_FORMAT=flat
# CAPTION_DEVICE: auto | cpu | cuda. Force GPU 4-bit (with double-quant, ~2 GB)
# on the 3.62 GB GTX 1650. Fits because CLIP runs on CPU (CLIP_DEVICE=cpu) and
# double-quant shrinks the weights. Much faster than CPU captioning.
CAPTION_DEVICE=cuda
QWEN_VL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
CAPTION_MAX_NEW_TOKENS=128    # flat caption is short; smaller KV cache = more VRAM headroom
# Vision-token budget. On the 3.62 GB GTX 1650 the vision tower spikes per frame;
# 200704 (256*28*28) keeps activations small enough to avoid per-frame OOM.
# Raise toward 401408 if you free GPU memory (headless desktop); lower if still OOM.
QWEN_MAX_PIXELS=200704
# Local Qwen batch size: frames captioned per forward pass. >1 = faster but more
# RAM/VRAM. GTX 1650 = 3.62 GB usable; Qwen 4-bit alone ~2.5 GB, so batch MUST be 1.
CAPTION_BATCH_SIZE=1          # 1 frame/pass: Qwen 4-bit leaves ~1.1 GB; batching causes OOM
# Concurrent requests for the Ollama caption/OCR path (network-bound). Only
# helps when CAPTION_BACKEND=ollama or OCR_BACKEND=ollama. Ignored for local
# models. Lower to 1 if your Ollama server OOMs under parallel requests.
OLLAMA_CONCURRENCY=4
# GPU with >= VRAM_THRESHOLD_GB runs Qwen/BLIP-2 in 4-bit; otherwise CPU/float.
# GTX 1650 = 4 GB VRAM -> set threshold below 4 so 4-bit Qwen loads on GPU.
VRAM_THRESHOLD_GB=3
CAPTION_DEDUP_THRESHOLD=0.92

# ── Pose / action detection (fall / fight / running) ──────────
# Rule-based events from YOLO-pose keypoints. Fall is reliable; fight/running
# are single-frame heuristics (proper temporal actions need tracking).
# POSE_ENABLED = single-frame pose on keyframes (fall/fight/running/crowding).
# POSE_ACTION_ENABLED = temporal multi-frame pose during the track pass
# (fall/running/handshake/fight/sudden movement — the useful one). Keep the
# single-frame one OFF when temporal is ON, so pose doesn't run twice.
POSE_ENABLED=false
POSE_ACTION_ENABLED=true
POSE_MODEL=/app/model-cache/yolov8n-pose.pt
POSE_CONFIDENCE=0.3
CROWD_PERSON_THRESHOLD=5

# ── Weapon detection (fine-tuned YOLOv11m: handgun / long_gun / knife) ─
WEAPON_ENABLED=true
WEAPON_MODEL=/app/model-cache/weapon_yolov11m.pt
WEAPON_CONFIDENCE=0.45        # high to suppress false alarms (phones/tools as guns)
WEAPON_IMGSZ=640
WEAPON_DEVICE=cpu             # cpu: keep the 4 GB GPU free for the caption VLM

# ── OCR (dedicated text / number-plate reading) ───────────────
# OCR_BACKEND: none (use VLM caption OCR), paddle (local PaddleOCR — needs
# `pip install paddleocr paddlepaddle`), or ollama (vision model OCR prompt).
OCR_BACKEND=none
OCR_LANGUAGES=en
OCR_MIN_CONFIDENCE=0.5
# Ollama OCR endpoint/model (empty URL reuses the caption/main Ollama server).
OCR_OLLAMA_BASE_URL=
OCR_OLLAMA_MODEL=qwen2.5vl

# ── Retrieval ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
CLIP_DEVICE=cpu

# ── Summarisation ─────────────────────────────────────────────
SUMMARY_WINDOW_SEC=30
LLM_MAX_TOKENS=1024

# ── Storage / servers ─────────────────────────────────────────
DATA_DIR=data
CHROMA_DIR=data/chroma
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
UI_PORT=3000
